# Copy this file to .env and fill in values from your Supabase project's
# Settings → API page. VITE_SUPABASE_ANON_KEY is the public "anon" key —
# safe to expose client-side, since row-level security (see
# supabase/migrations/0001_init.sql) is what actually protects data, not
# secrecy of this key.
#
# Never put the service_role key here or anywhere in this repo — it
# bypasses row-level security entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
